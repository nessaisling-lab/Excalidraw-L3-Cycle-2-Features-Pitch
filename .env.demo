# Demo build for the GitHub Pages preview Carlos clicks through.
#
# Deliberately NOT .env.production. Two differences matter:
#
# 1. The C1 prompt is switched on. Production builds keep it off, so a plain
#    production build of this repo would show Carlos stock Excalidraw.
# 2. Every write path to Excalidraw's own infrastructure is blanked. The
#    stock production env points share links at json.excalidraw.com and
#    collaboration at their room server and Firebase project. A public build
#    of ours must not write to a third party's production storage, so share
#    and live collaboration fail closed here instead. Saving to file — the
#    thing this demo exists to show — is entirely local and unaffected.
#
# Read-only library browsing is left pointing at the public library site, so
# the app does not look broken.

MODE="production"

VITE_APP_BACKEND_V2_GET_URL=
VITE_APP_BACKEND_V2_POST_URL=

VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries

VITE_APP_PLUS_LP=https://plus.excalidraw.com
VITE_APP_PLUS_APP=https://app.excalidraw.com

VITE_APP_AI_BACKEND=

# socket server URL used for collaboration
VITE_APP_WS_SERVER_URL=

VITE_APP_FIREBASE_CONFIG='{}'

VITE_APP_ENABLE_TRACKING=false

VITE_APP_PLUS_EXPORT_PUBLIC_KEY='MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEApQ0jM9Qz8TdFLzcuAZZX
/WvuKSOJxiw6AR/ZcE3eFQWM/mbFdhQgyK8eHGkKQifKzH1xUZjCxyXcxW6ZO02t
kPOPxhz+nxUrIoWCD/V4NGmUA1lxwHuO21HN1gzKrN3xHg5EGjyouR9vibT9VDGF
gq6+4Ic/kJX+AD2MM7Yre2+FsOdysrmuW2Fu3ahuC1uQE7pOe1j0k7auNP0y1q53
PrB8Ts2LUpepWC1l7zIXFm4ViDULuyWXTEpUcHSsEH8vpd1tckjypxCwkipfZsXx
iPszy0o0Dx2iArPfWMXlFAI9mvyFCyFC3+nSvfyAUb2C4uZgCwAuyFh/ydPF4DEE
PQIDAQAB'

# Set the below flags explicitly to false in production mode since vite loads and merges .env.local vars when  running the build command
VITE_APP_DEBUG_ENABLE_TEXT_CONTAINER_BOUNDING_BOX=false
VITE_APP_COLLAPSE_OVERLAY=false
# Enable eslint in dev server
VITE_APP_ENABLE_ESLINT=false

# --- demo-only additions -----------------------------------------------------

# Renders the First-Save Moment prompt in a production build. Off everywhere
# else, so this cannot leak into a normal build.
VITE_APP_ENABLE_C1=true

# No Sentry project for this build; errors go to the console.
VITE_APP_DISABLE_SENTRY=true

# No service worker. Under a Pages sub-path a stale worker is a classic
# "the client swears they still see the old version" bug, and this demo gets
# redeployed as each stage lands.
VITE_APP_DISABLE_PWA=true

# CI lints separately; skip the in-build checker so the demo build is quick.
VITE_APP_ENABLE_ESLINT=false

# Drops the Simple Analytics snippet, which the page template gates on PROD.
VITE_APP_IS_DEMO=true
